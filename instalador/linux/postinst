#!/bin/sh
set -e

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
fi

# Equivalente a regra de firewall que o instalador do Windows cria: libera a porta 8888 para
# os outros computadores da rede, mas so se o ufw estiver ativo.
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
    ufw allow 8888/tcp comment CertiManager >/dev/null || true
fi

exit 0
