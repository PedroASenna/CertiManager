<service>
  <id>AgenteTerminal</id>
  <name>CertiManager - Agente Terminal</name>
  <description>Le certificados A3 no leitor USB local desta maquina e expoe para o CertiManager via HTTP (porta 8889).</description>

  <executable>java</executable>
  <arguments>-jar "%BASE%\AgenteTerminal.jar"</arguments>

  <startmode>Automatic</startmode>
  <stoptimeout>15 sec</stoptimeout>

  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>

  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
